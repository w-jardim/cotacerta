// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN_PLATFORM
  GESTOR_MASTER
  COTISTA
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum CashGroupStatus {
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

enum MemberStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum MonthlyChargeStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
  CANCELED
}

enum PaymentMethod {
  PIX
}

enum PaymentRequestStatus {
  PENDING_REVIEW
  AUTO_MATCHED
  NEEDS_MANUAL_REVIEW
  MISMATCH
  CONFIRMED
  REJECTED
  CANCELED
}

enum PaymentRequestAnalysisStatus {
  NOT_ANALYZED
  AUTO_MATCHED
  NEEDS_MANUAL_REVIEW
  MISMATCH
}

enum PaymentRequestType {
  MONTHLY_CHARGE
  LOAN
}

enum ReceivingMethod {
  PIX
  CASH
  OTHER
}

enum LoanStatus {
  OPEN
  PARTIAL
  PAID
  CANCELED
}

enum LoanPaymentMethod {
  PIX
  CASH
  OTHER
}

enum LoanPaymentStatus {
  CONFIRMED
  CANCELED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(GESTOR_MASTER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  cashGroups          CashGroup[]
  member              Member?
  reviewedRequests    PaymentRequest[]

  @@map("users")
}

model CashGroup {
  id                      String          @id @default(cuid())
  ownerUserId             String          @map("owner_user_id")
  name                    String
  description             String?
  cycleYear               Int             @map("cycle_year")
  quotaValue              Decimal         @map("quota_value") @db.Decimal(10, 2)
  dueDay                  Int             @map("due_day")
  maxQuotasPerMember      Int             @default(2) @map("max_quotas_per_member")
  defaultLoanInterestRate Decimal         @default(30.00) @map("default_loan_interest_rate") @db.Decimal(5, 2)
  receivingPixEnabledForCharges Boolean   @default(false) @map("receiving_pix_enabled_for_charges")
  receivingPixEnabledForLoans   Boolean   @default(false) @map("receiving_pix_enabled_for_loans")
  receivingPixKey         String?         @map("receiving_pix_key")
  receivingPixKeyHolder   String?         @map("receiving_pix_key_holder")
  receivingPixReceiverCity String?        @map("receiving_pix_receiver_city")
  receivingPixDescriptionPrefix String?   @map("receiving_pix_description_prefix")
  receivingInstructions   String?         @map("receiving_instructions")
  status                  CashGroupStatus @default(ACTIVE)
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  owner                   User            @relation(fields: [ownerUserId], references: [id])
  members                 Member[]
  monthlyCharges          MonthlyCharge[]
  chargePayments          ChargePayment[]
  loans                   Loan[]
  annualClosings          AnnualClosing[]
  paymentRequests         PaymentRequest[]

  @@index([ownerUserId])
  @@map("cash_groups")
}

model Member {
  id                 String       @id @default(cuid())
  cashGroupId        String       @map("cash_group_id")
  userId             String?      @unique @map("user_id")
  name               String
  cpf                String?      @map("cpf")
  phone              String?
  pixKey             String?      @map("pix_key")
  bankInstitution    String?      @map("bank_institution")
  bankAccountHolder  String?      @map("bank_account_holder")
  quotasCount        Int          @map("quotas_count")
  status             MemberStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  cashGroup           CashGroup    @relation(fields: [cashGroupId], references: [id])
  user                User?        @relation(fields: [userId], references: [id])
  monthlyCharges      MonthlyCharge[]
  chargePayments      ChargePayment[]
  loans               Loan[]
  annualClosingResults AnnualClosingMemberResult[]
  profileChangeRequests MemberProfileChangeRequest[]
  paymentRequests     PaymentRequest[]

  @@index([cashGroupId])
  @@map("members")
}

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model MemberProfileChangeRequest {
  id              String              @id @default(cuid())
  memberId        String              @map("member_id")
  requestedData   Json                @map("requested_data")
  status          ProfileChangeStatus @default(PENDING)
  rejectionReason String?             @map("rejection_reason")
  reviewedAt      DateTime?           @map("reviewed_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  member          Member              @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([status])
  @@map("member_profile_change_requests")
}

model MonthlyCharge {
  id              String              @id @default(cuid())
  cashGroupId     String              @map("cash_group_id")
  memberId        String              @map("member_id")
  referenceMonth  Int                 @map("reference_month")
  referenceYear   Int                 @map("reference_year")
  quotasCount     Int                 @map("quotas_count")
  baseAmount      Decimal             @map("base_amount") @db.Decimal(10, 2)
  amountDue       Decimal             @map("amount_due") @db.Decimal(10, 2)
  amountPaid      Decimal             @default(0) @map("amount_paid") @db.Decimal(10, 2)
  dueDate         DateTime            @map("due_date")
  paidAt          DateTime?           @map("paid_at")
  status          MonthlyChargeStatus @default(PENDING)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  cashGroup       CashGroup           @relation(fields: [cashGroupId], references: [id])
  member          Member              @relation(fields: [memberId], references: [id])
  payments        ChargePayment[]
  paymentRequests PaymentRequest[]

  @@unique([cashGroupId, memberId, referenceMonth, referenceYear])
  @@index([cashGroupId])
  @@index([memberId])
  @@index([referenceMonth, referenceYear])
  @@map("monthly_charges")
}

model ChargePayment {
  id              String         @id @default(cuid())
  monthlyChargeId String         @map("monthly_charge_id")
  cashGroupId     String         @map("cash_group_id")
  memberId        String         @map("member_id")
  amountPaid      Decimal        @map("amount_paid") @db.Decimal(10, 2)
  paidAt          DateTime       @map("paid_at")
  paymentMethod   PaymentMethod  @default(PIX) @map("payment_method")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  monthlyCharge   MonthlyCharge  @relation(fields: [monthlyChargeId], references: [id])
  cashGroup       CashGroup      @relation(fields: [cashGroupId], references: [id])
  member          Member         @relation(fields: [memberId], references: [id])
  receipt         PaymentReceipt?

  @@index([monthlyChargeId])
  @@index([cashGroupId])
  @@index([memberId])
  @@index([paidAt])
  @@map("charge_payments")
}

model PaymentReceipt {
  id          String        @id @default(cuid())
  paymentId   String        @unique @map("payment_id")
  fileName    String        @map("file_name")
  mimeType    String        @map("mime_type")
  sizeBytes   Int           @map("size_bytes")
  dataUrl     String        @map("data_url")
  receiptHash String?       @map("receipt_hash")
  createdAt   DateTime      @default(now()) @map("created_at")

  payment     ChargePayment @relation(fields: [paymentId], references: [id])

  @@index([receiptHash])
  @@map("payment_receipts")
}

model Loan {
  id              String     @id @default(cuid())
  cashGroupId     String     @map("cash_group_id")
  memberId        String     @map("member_id")
  principalAmount Decimal    @map("principal_amount") @db.Decimal(10, 2)
  interestRate    Decimal    @map("interest_rate") @db.Decimal(5, 2)
  totalDue        Decimal    @map("total_due") @db.Decimal(10, 2)
  amountPaid      Decimal    @default(0) @map("amount_paid") @db.Decimal(10, 2)
  grantedAt       DateTime   @map("granted_at")
  dueDate         DateTime?  @map("due_date")
  paidAt          DateTime?  @map("paid_at")
  status          LoanStatus @default(OPEN)
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  cashGroup       CashGroup     @relation(fields: [cashGroupId], references: [id])
  member          Member        @relation(fields: [memberId], references: [id])
  payments        LoanPayment[]
  paymentRequests PaymentRequest[]

  @@index([cashGroupId])
  @@index([memberId])
  @@map("loans")
}

model LoanPayment {
  id           String            @id @default(cuid())
  loanId        String            @map("loan_id")
  amount        Decimal           @db.Decimal(10, 2)
  method        LoanPaymentMethod @default(PIX)
  status        LoanPaymentStatus @default(CONFIRMED)
  paidAt        DateTime          @map("paid_at")
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  loan          Loan              @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@index([paidAt])
  @@map("loan_payments")
}

enum AnnualClosingStatus {
  SIMULATED
  CONFIRMED
  CANCELED
}

model PaymentRequest {
  id               String               @id @default(cuid())
  cashGroupId      String               @map("cash_group_id")
  memberId         String               @map("member_id")
  type             PaymentRequestType
  monthlyChargeId  String?              @map("monthly_charge_id")
  loanId           String?              @map("loan_id")
  method           ReceivingMethod
  amountDeclared   Decimal              @map("amount_declared") @db.Decimal(10, 2)
  receiptFileName  String?              @map("receipt_file_name")
  receiptMimeType  String?              @map("receipt_mime_type")
  receiptDataUrl   String?              @map("receipt_data_url")
  receiptHash      String?              @map("receipt_hash")
  notes            String?
  status           PaymentRequestStatus @default(PENDING_REVIEW)
  reviewedByUserId String?              @map("reviewed_by_user_id")
  reviewedAt       DateTime?            @map("reviewed_at")
  reviewNotes      String?              @map("review_notes")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  cashGroup        CashGroup            @relation(fields: [cashGroupId], references: [id])
  member           Member               @relation(fields: [memberId], references: [id])
  monthlyCharge    MonthlyCharge?       @relation(fields: [monthlyChargeId], references: [id])
  loan             Loan?                @relation(fields: [loanId], references: [id])
  reviewedBy       User?                @relation(fields: [reviewedByUserId], references: [id])
  pixPayload       PixPaymentPayload?
  analysis         PaymentRequestAnalysis?

  @@index([cashGroupId])
  @@index([memberId])
  @@index([receiptHash])
  @@index([status])
  @@map("payment_requests")
}

model PaymentRequestAnalysis {
  id                String                       @id @default(cuid())
  paymentRequestId  String                       @unique @map("payment_request_id")
  status            PaymentRequestAnalysisStatus @default(NOT_ANALYZED)
  extractedText     String?                      @map("extracted_text")
  extractedAmount   Decimal?                     @map("extracted_amount") @db.Decimal(10, 2)
  extractedPaidAt   DateTime?                    @map("extracted_paid_at")
  extractedReceiver String?                      @map("extracted_receiver")
  extractedPixKey   String?                      @map("extracted_pix_key")
  extractedTxid     String?                      @map("extracted_txid")
  extractedBank     String?                      @map("extracted_bank")
  expectedAmount    Decimal?                     @map("expected_amount") @db.Decimal(10, 2)
  expectedReceiver  String?                      @map("expected_receiver")
  expectedPixKey    String?                      @map("expected_pix_key")
  amountMatches     Boolean?                     @map("amount_matches")
  receiverMatches   Boolean?                     @map("receiver_matches")
  pixKeyMatches     Boolean?                     @map("pix_key_matches")
  dateLooksValid    Boolean?                     @map("date_looks_valid")
  issues            Json?
  analyzedAt        DateTime?                    @map("analyzed_at")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")

  paymentRequest    PaymentRequest               @relation(fields: [paymentRequestId], references: [id])

  @@map("payment_request_analyses")
}

model PixPaymentPayload {
  id               String         @id @default(cuid())
  paymentRequestId String         @unique @map("payment_request_id")
  pixKey           String         @map("pix_key")
  receiverName     String         @map("receiver_name")
  receiverCity     String         @map("receiver_city")
  amount           Decimal        @db.Decimal(10, 2)
  description      String?
  txid             String?
  copyPasteCode    String         @map("copy_paste_code")
  createdAt        DateTime       @default(now()) @map("created_at")

  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id])

  @@map("pix_payment_payloads")
}

model AnnualClosing {
  id                   String              @id @default(cuid())
  groupId              String              @map("group_id")
  cycleYear            Int                 @map("cycle_year")
  status               AnnualClosingStatus @default(SIMULATED)

  totalQuotaReceived   Decimal             @default(0) @map("total_quota_received") @db.Decimal(10, 2)
  totalLoanReceived    Decimal             @default(0) @map("total_loan_received") @db.Decimal(10, 2)
  totalAvailable       Decimal             @default(0) @map("total_available") @db.Decimal(10, 2)

  totalQuotaPending    Decimal             @default(0) @map("total_quota_pending") @db.Decimal(10, 2)
  totalLoanPending     Decimal             @default(0) @map("total_loan_pending") @db.Decimal(10, 2)
  totalPending         Decimal             @default(0) @map("total_pending") @db.Decimal(10, 2)

  totalQuotas          Int                 @default(0) @map("total_quotas")
  valuePerQuota        Decimal             @default(0) @map("value_per_quota") @db.Decimal(10, 2)

  confirmedAt          DateTime?           @map("confirmed_at")
  canceledAt           DateTime?           @map("canceled_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  group                CashGroup           @relation(fields: [groupId], references: [id])
  results              AnnualClosingMemberResult[]

  @@index([groupId])
  @@map("annual_closings")
}

model AnnualClosingMemberResult {
  id                  String        @id @default(cuid())
  closingId           String        @map("closing_id")
  memberId            String        @map("member_id")

  quotaQuantity       Int           @map("quota_quantity")
  grossAmount         Decimal       @map("gross_amount") @db.Decimal(10, 2)
  quotaDebtAmount     Decimal       @default(0) @map("quota_debt_amount") @db.Decimal(10, 2)
  loanDebtAmount      Decimal       @default(0) @map("loan_debt_amount") @db.Decimal(10, 2)
  totalDebtAmount     Decimal       @default(0) @map("total_debt_amount") @db.Decimal(10, 2)
  netAmount           Decimal       @default(0) @map("net_amount") @db.Decimal(10, 2)
  remainingDebtAmount Decimal       @default(0) @map("remaining_debt_amount") @db.Decimal(10, 2)

  createdAt           DateTime      @default(now()) @map("created_at")

  closing             AnnualClosing @relation(fields: [closingId], references: [id], onDelete: Cascade)
  member              Member        @relation(fields: [memberId], references: [id])

  @@index([closingId])
  @@index([memberId])
  @@map("annual_closing_member_results")
}

