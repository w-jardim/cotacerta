// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN_PLATFORM
  GESTOR_MASTER
  COTISTA
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum CashGroupStatus {
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

enum MemberStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum MonthlyChargeStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
  CANCELED
}

enum PaymentMethod {
  PIX
}

enum LoanStatus {
  OPEN
  PARTIAL
  PAID
  CANCELED
}

enum LoanPaymentMethod {
  PIX
  CASH
  OTHER
}

enum LoanPaymentStatus {
  CONFIRMED
  CANCELED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(GESTOR_MASTER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  cashGroups   CashGroup[]

  @@map("users")
}

model CashGroup {
  id                      String          @id @default(cuid())
  ownerUserId             String          @map("owner_user_id")
  name                    String
  description             String?
  cycleYear               Int             @map("cycle_year")
  quotaValue              Decimal         @map("quota_value") @db.Decimal(10, 2)
  dueDay                  Int             @map("due_day")
  maxQuotasPerMember      Int             @default(2) @map("max_quotas_per_member")
  defaultLoanInterestRate Decimal         @default(30.00) @map("default_loan_interest_rate") @db.Decimal(5, 2)
  status                  CashGroupStatus @default(ACTIVE)
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  owner                   User            @relation(fields: [ownerUserId], references: [id])
  members                 Member[]
  monthlyCharges          MonthlyCharge[]
  chargePayments          ChargePayment[]
  loans                   Loan[]

  @@index([ownerUserId])
  @@map("cash_groups")
}

model Member {
  id           String       @id @default(cuid())
  cashGroupId  String       @map("cash_group_id")
  name         String
  phone        String?
  pixKey       String?      @map("pix_key")
  quotasCount  Int          @map("quotas_count")
  status       MemberStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  cashGroup    CashGroup    @relation(fields: [cashGroupId], references: [id])
  monthlyCharges MonthlyCharge[]
  chargePayments ChargePayment[]
  loans         Loan[]

  @@index([cashGroupId])
  @@map("members")
}

model MonthlyCharge {
  id              String              @id @default(cuid())
  cashGroupId     String              @map("cash_group_id")
  memberId        String              @map("member_id")
  referenceMonth  Int                 @map("reference_month")
  referenceYear   Int                 @map("reference_year")
  quotasCount     Int                 @map("quotas_count")
  baseAmount      Decimal             @map("base_amount") @db.Decimal(10, 2)
  amountDue       Decimal             @map("amount_due") @db.Decimal(10, 2)
  amountPaid      Decimal             @default(0) @map("amount_paid") @db.Decimal(10, 2)
  dueDate         DateTime            @map("due_date")
  paidAt          DateTime?           @map("paid_at")
  status          MonthlyChargeStatus @default(PENDING)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  cashGroup       CashGroup           @relation(fields: [cashGroupId], references: [id])
  member          Member              @relation(fields: [memberId], references: [id])
  payments        ChargePayment[]

  @@unique([cashGroupId, memberId, referenceMonth, referenceYear])
  @@index([cashGroupId])
  @@index([memberId])
  @@index([referenceMonth, referenceYear])
  @@map("monthly_charges")
}

model ChargePayment {
  id              String         @id @default(cuid())
  monthlyChargeId String         @map("monthly_charge_id")
  cashGroupId     String         @map("cash_group_id")
  memberId        String         @map("member_id")
  amountPaid      Decimal        @map("amount_paid") @db.Decimal(10, 2)
  paidAt          DateTime       @map("paid_at")
  paymentMethod   PaymentMethod  @default(PIX) @map("payment_method")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  monthlyCharge   MonthlyCharge  @relation(fields: [monthlyChargeId], references: [id])
  cashGroup       CashGroup      @relation(fields: [cashGroupId], references: [id])
  member          Member         @relation(fields: [memberId], references: [id])
  receipt         PaymentReceipt?

  @@index([monthlyChargeId])
  @@index([cashGroupId])
  @@index([memberId])
  @@index([paidAt])
  @@map("charge_payments")
}

model PaymentReceipt {
  id          String        @id @default(cuid())
  paymentId   String        @unique @map("payment_id")
  fileName    String        @map("file_name")
  mimeType    String        @map("mime_type")
  sizeBytes   Int           @map("size_bytes")
  dataUrl     String        @map("data_url")
  createdAt   DateTime      @default(now()) @map("created_at")

  payment     ChargePayment @relation(fields: [paymentId], references: [id])

  @@map("payment_receipts")
}

model Loan {
  id              String     @id @default(cuid())
  cashGroupId     String     @map("cash_group_id")
  memberId        String     @map("member_id")
  principalAmount Decimal    @map("principal_amount") @db.Decimal(10, 2)
  interestRate    Decimal    @map("interest_rate") @db.Decimal(5, 2)
  totalDue        Decimal    @map("total_due") @db.Decimal(10, 2)
  amountPaid      Decimal    @default(0) @map("amount_paid") @db.Decimal(10, 2)
  grantedAt       DateTime   @map("granted_at")
  dueDate         DateTime?  @map("due_date")
  paidAt          DateTime?  @map("paid_at")
  status          LoanStatus @default(OPEN)
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  cashGroup       CashGroup     @relation(fields: [cashGroupId], references: [id])
  member          Member        @relation(fields: [memberId], references: [id])
  payments        LoanPayment[]

  @@index([cashGroupId])
  @@index([memberId])
  @@map("loans")
}

model LoanPayment {
  id           String            @id @default(cuid())
  loanId        String            @map("loan_id")
  amount        Decimal           @db.Decimal(10, 2)
  method        LoanPaymentMethod @default(PIX)
  status        LoanPaymentStatus @default(CONFIRMED)
  paidAt        DateTime          @map("paid_at")
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  loan          Loan              @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@index([paidAt])
  @@map("loan_payments")
}
