# App
NODE_ENV=development

# API
API_PORT=3401
JWT_SECRET=change_me_in_real_environment
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://cotacerta:cotacerta_dev_password@localhost:3341/cotacerta?schema=public

# Web
# Em desenvolvimento local: http://localhost:3401
# Em produção (via Nginx proxy): /api
VITE_API_URL=http://localhost:3401

# ──────────────────────────────────────────────────────────
# IA / OpenAI Configuration (OPCIONAL)
# ──────────────────────────────────────────────────────────
# Sistema funciona 100% sem estas configurações
# IA é assistiva: sugere ações, gestor decide

# Habilitar IA globalmente (default: false)
AI_ENABLED=false

# Provider padrão para novos gestores (default: local)
# Opções: local, openai
AI_DEFAULT_PROVIDER=local

# Chave API OpenAI (opcional)
# Se não configurada, apenas LocalProvider estará disponível
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo OpenAI a usar (default: gpt-4)
# Opções: gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# Timeout para chamadas OpenAI em ms (default: 30000)
OPENAI_TIMEOUT=30000

# Chave de criptografia para API keys de gestores (32 bytes hex)
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=
